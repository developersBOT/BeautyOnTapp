# BeautyOnTApp — Local Google Ads Auditor configuration
# ---------------------------------------------------------------------------
# Copy this to config.env in the same folder and edit. config.env is gitignored
# because it contains machine-specific paths.
#
#   cp config.example.env config.env
# ---------------------------------------------------------------------------

# Where your local clone of the BeautyOnTApp repo lives.
# The auditor commits its reports here and pushes to the automation/reports branch.
REPO_DIR="$HOME/BeautyOnTapp"

# Folders to sweep for Google Ads exports. Space-separated, quoted.
# Every CSV/XLSX found in these folders is examined — nothing is skipped.
# Add any folder where you save Google Ads downloads.
WATCH_DIRS="$HOME/Downloads $HOME/Desktop $HOME/BeautyOnTApp-GoogleAds"

# How far back to consider a file relevant, in days.
# Set to 0 to audit EVERY export ever found, regardless of age (full sweep).
MAX_AGE_DAYS=0

# Where run logs are written.
LOG_DIR="$HOME/Library/Logs/beautyontapp-gads-auditor"

# Claude Code CLI invocation.
# Leave CLAUDE_BIN as "claude" if it is on your PATH.
CLAUDE_BIN="claude"

# Permission mode for the unattended run. The auditor only reads your export
# files and writes inside REPO_DIR, so acceptEdits is normally right.
# If the run stalls waiting for approval, switch to: --dangerously-skip-permissions
CLAUDE_PERMISSION_FLAG="--permission-mode acceptEdits"

# Optional: pin a model. Leave empty to use your CLI default.
CLAUDE_MODEL=""

# Set to 1 for a dry run: discover and list files, but do not invoke Claude,
# do not copy exports, and do not push. Useful for the first test.
DRY_RUN=0
